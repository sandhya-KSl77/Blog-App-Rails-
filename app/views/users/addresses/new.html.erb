<div class="container mt-5">
  <div class="card shadow-sm">
    <div class="card-header bg-secondary text-white text-center">
      <h3>Submit Address</h3>
    </div>

    <div class="card-body">
      <%= form_with model: @address, url: users_addresses_path, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :line1 %>
          <%= f.text_field :line1, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :line2 %>
          <%= f.text_field :line2, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :city %>
          <%= f.text_field :city, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :zip %>
          <%= f.text_field :zip, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :address_type %>
          <%= f.select :address_type, ['billing', 'mailing'], {}, class: "form-select" %>
        </div>

        <div class="text-center">
          <%= f.submit "Submit Address", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
